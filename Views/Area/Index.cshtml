@model IEnumerable<SchoolManager.Models.Area>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestión de Áreas";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="portal-header">
                <h3><i class="fas fa-th-large mr-2"></i>Gestión de Áreas</h3>
                <small>Administrar áreas académicas</small>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col-12">
            <button type="button" class="btn btn-primary" id="btnNuevaArea">
                <i class="fas fa-plus mr-2"></i>Nueva Área
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-list mr-2"></i>Lista de Áreas</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle mr-2"></i>No hay áreas registradas.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover" id="areasTable">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Descripción</th>
                                        <th>Código</th>
                                        <th>Global</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var area in Model)
                                    {
                                        <tr>
                                            <td>@area.Name</td>
                                            <td>@(area.Description ?? "-")</td>
                                            <td>@(area.Code ?? "-")</td>
                                            <td>
                                                @if (area.IsGlobal)
                                                {
                                                    <span class="badge bg-info">Global</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Escuela</span>
                                                }
                                            </td>
                                            <td>
                                                @if (area.IsActive)
                                                {
                                                    <span class="badge bg-success">Activa</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inactiva</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
